# Configure these with Sites runtime environment settings, never in browser code.
# Blank values keep cloud speech disabled; the public website still works.
OPENAI_API_KEY=
SPEECH_ALLOWED_EMAILS=

# Metered credential-scoped key (not account Secret Key). Domain only, no https://.
METERED_DOMAIN=
METERED_TURN_API_KEY=

# Alternative: Metered global relay credential from dashboard
METERED_TURN_USERNAME=
METERED_TURN_PASSWORD=

# Supabase free project; keep service_role and VAPID private key in Worker secrets only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
